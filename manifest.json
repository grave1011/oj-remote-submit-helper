{
  "manifest_version": 3,
  "name": "OJ Remote Submit Helper Lite",
  "short_name": "OJ Submit Lite",
  "version": "0.3.11",
  "description": "Browser-assisted remote submissions for AtCoder, Codeforces, Gym and Luogu, with manual verification and final submit.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://atcoder.jp/*",
    "https://codeforces.com/*",
    "https://www.luogu.com.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/grave1011/sdustjudge",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*",
        "https://sdustjudge.cn/*",
        "https://*.sdustjudge.cn/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "OJ Remote Submit Helper Lite"
  }
}
